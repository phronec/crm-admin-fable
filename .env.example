# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never commit real keys.

# The same Supabase project as the customer app (crm-fable).
# Project URL and publishable key. Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (the service role key). SERVER ONLY.
# It bypasses row-level security and can read every customer's data.
# Never prefix it with NEXT_PUBLIC_, never log it, never paste it anywhere else.
SUPABASE_SECRET_KEY=
